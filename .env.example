SECRET_KEY_BASE=changeme_generate_with_mix_phx_gen_secret
# debug | info | warning | error (default: info en produccion)
LOG_LEVEL=info

# Conexiones a Mongo que mantiene messaging. Sin pool, el driver usa una
# sola y todas las consultas hacen fila.
MONGO_POOL_SIZE=10

# Postgres del outbox. Local: el del compose (puerto 5435). Produccion: Supabase,
# Session pooler (host aws-0-<region>.pooler.supabase.com, usuario postgres.<project-ref>),
# DATABASE_SSLMODE=require y DATABASE_SCHEMA=messaging.
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=discordia_messaging
DATABASE_USER=discordia
DATABASE_PASSWORD=discordia
DATABASE_SSLMODE=disable
DATABASE_SCHEMA=

# Secreto con el que discordia-admin firma los eventos admin.* (HMAC-SHA256). Tiene que ser
# el mismo valor que en admin. Vacio: el consumidor de esos eventos no arranca.
ADMIN_EVENTS_HMAC_SECRET=

# Secreto con el que discordia-billing firma billing.premium_updated (HMAC-SHA256). Tiene que
# ser el mismo valor que en billing. Vacio: el consumidor de esos eventos no arranca.
BILLING_EVENTS_HMAC_SECRET=

# Estado de actividad: inactividad (ms) tras la que el cliente se reporta ausente, cada cuanto
# escribe cada instancia que sigue viva y cuanto sin escribir para darla por caida.
PRESENCE_IDLE_MS=300000
PRESENCE_INSTANCE_HEARTBEAT_MS=10000
PRESENCE_INSTANCE_STALE_MS=30000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
